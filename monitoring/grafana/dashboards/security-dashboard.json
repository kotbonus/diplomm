{
  "dashboard": {
    "id": null,
    "title": "Wishlist App - Безопасность",
    "tags": ["wishlist", "security"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Неудачные аутентификации",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(security_auth_failures_total[1h])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "События безопасности",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(security_events_total[1h])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 50
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Запросы на сброс пароля",
        "type": "stat",
        "targets": [
          {
            "expr": "increase(password_reset_requests_total[1h])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 3
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 4,
        "title": "Соотношение успешных/неудачных входов",
        "type": "stat",
        "targets": [
          {
            "expr": "rate(user_logins_total[5m]) / (rate(user_logins_total[5m]) + rate(security_auth_failures_total[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 80
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 18,
          "y": 0
        }
      },
      {
        "id": 5,
        "title": "Безопасность - Временной ряд",
        "type": "timeseries",
        "targets": [
          {
            "expr": "increase(security_auth_failures_total[1h])",
            "refId": "A",
            "legendFormat": "Неудачные входы"
          },
          {
            "expr": "increase(security_events_total[1h])",
            "refId": "B",
            "legendFormat": "События безопасности"
          },
          {
            "expr": "increase(password_reset_requests_total[1h])",
            "refId": "C",
            "legendFormat": "Сброс пароля"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 8
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "5s"
  }
}
